{
  "name": "video-calls",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "One-to-one video calls with private rooms and realtime chat.",
  "author": "Konstantin Lubinets",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lubinetskn/video-calls.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "start": "tsx apps/server/src/index.ts",
    "test": "tsx --test apps/server/src/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/static": "latest",
    "fastify": "5.12.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "8.3.8"
  }
}
